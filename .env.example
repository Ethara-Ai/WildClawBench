# ============================================================================
# WildClawBench (LiteLLM/Bedrock fork) — environment template
# ----------------------------------------------------------------------------
# Copy to .env and fill in your values:   cp .env.example .env
# .env is gitignored; NEVER put real secrets in this .env.example (it is tracked).
# Variable names below are exactly what the code reads (config.py / run_batch.py
# / docker_utils.py). KENSEI_* names are the primary keys; generic aliases noted.
# ============================================================================

# ===== Container / runtime =====
# Leave DOCKER_IMAGE unset to run the DEFAULT agent image, wildclawbench-ubuntu:v1.6
# (the v1.3 base + openai-whisper + LibreOffice). It is built locally, once:
#   bash script/build_agent_image.sh          (~20 min; script/run.sh preflight does the same)
# A direct `python3 eval/run_batch.py` does NOT build images — it stops with the
# command above when the image is missing. Other tags, each with its own recipe
# (any other tag is refused rather than baked):
#   wildclawbench-ubuntu:v1.3  the bare base (no whisper, no soffice) — builds nothing
#   wildclawbench-ubuntu:v1.4  base + openai-whisper 'small' (local transcription)
#   wildclawbench-ubuntu:v1.5  base + LibreOffice (soffice --headless)
# run.sh resolves the tag once and exports it, so preflight and run_batch always
# use the same image.
# DOCKER_IMAGE=wildclawbench-ubuntu:v1.3
GATEWAY_PORT=18789
TMP_WORKSPACE=/tmp_workspace
TASKS_SUBDIR=tasks
OUTPUT_SUBDIR=output
DEFAULT_PARALLEL=1
# Default model. In LiteLLM mode use a sidecar id (claude-opus-4.7 / gpt-5.5);
# otherwise an OpenRouter string (e.g. openrouter/anthropic/claude-sonnet-4.6).
DEFAULT_MODEL=openrouter/anthropic/claude-sonnet-4.6

# ===== Inner proxy (optional; leave blank for none -> NO_PROXY defaults to *) =====
HTTP_PROXY_INNER=
HTTPS_PROXY_INNER=
NO_PROXY_INNER=

# ===== OpenRouter (fallback routing when LiteLLM is not enabled) =====
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM judge used by some tasks' automated checks
JUDGE_MODEL=openai/gpt-5.4
# Brave key is passed to the container; 'placeholder' prevents a gateway crash
BRAVE_API_KEY=placeholder
# For --models-config files that contain ${MY_PROXY_API_KEY}
# MY_PROXY_API_KEY=

# ============================================================================
# LiteLLM / Bedrock routing (openclaw backend)
# If Bedrock (ARN + bearer token) OR OpenAI is set, openclaw auto-routes through
# a shared LiteLLM sidecar instead of OpenRouter. Force with --litellm / --no-litellm.
# ============================================================================
# --- AWS Bedrock (Claude via Bedrock API key / bearer token) ---
# alias: BEDROCK_MODEL_ARN
KENSEI_BEDROCK_MODEL_ARN=          # arn:aws:bedrock:<region>:<acct>:application-inference-profile/<id>  (Opus 4.6/4.7 profile; also used by test-gen)
# Sonnet 4.6 inference profile (used when claude-sonnet-4-6 routes through the
# sidecar). Same application-inference-profile ARN format as above.
# alias: BEDROCK_SONNET_ARN
KENSEI_BEDROCK_SONNET_ARN=         # arn:aws:bedrock:ap-south-1:<acct>:application-inference-profile/<id>
# alias: AWS_REGION
KENSEI_AWS_REGION=ap-south-1
# Region for the OpenAI-family Bedrock route (bedrock_mantle / gpt-5.6-sol), which
# reuses the SAME bearer token as the Anthropic routes above. DELIBERATELY separate
# from KENSEI_AWS_REGION: the bare `openai.gpt-5.6-sol` id is served in-region only
# in us-east-1 / us-east-2 (ap-south-1 offers it via Global CRIS only, which drops
# off the native /openai/v1/responses path). Default us-east-2 if unset.
# alias: KENSEI_BEDROCK_GPT_REGION
KENSEI_GPT56_BEDROCK_REGION=us-east-2

# --- Claude Max OAuth subscription (per-user, per-laptop) ---
# These power `wcb login` so trajectories + the Sonnet judge run on YOUR own
# Claude Max subscription instead of a metered API key. Each teammate fills in
# THEIR OWN values here on THEIR OWN machine — never commit real secrets (.env
# is gitignored; only this .env.example template is tracked). No KENSEI_ prefix
# fallback exists for these four; they are read verbatim.
# WCB_USE_CLAUDE_OAUTH=1
# WCB_CC_ACCOUNT_POOL=/Users/<you>/.wcb/oauth_pool/account_a.json
# WCB_CC_BRIDGE_SECRET=<openssl rand -hex 32>
# WCB_CC_STUB_KEY=sk-wcb-oauth-stub

# --- LLM-council judge ARNs (rubric grading) ---
# The 3-model council (Sonnet 4.6 + GLM 5 + Kimi K2.5) runs in parallel for
# rubric grading. Each member is a full bedrock/<application-inference-profile>
# ARN, read ONLY from these vars (no defaults in source) — set them to YOUR
# account's profiles. The VARIABLE NAME (not the ARN) decides the model family,
# so pricing/evidence-budget/cache rules live in code keyed by family and the
# opaque profile-id is NOT load-bearing — rotate the ARNs freely (e.g. monthly)
# and costs still resolve correctly. Per-model regions: GLM is us-east-1,
# Sonnet + Kimi are ap-south-1.
# JUDGE_COUNCIL_SONNET_ARN=bedrock/arn:aws:bedrock:ap-south-1:<acct>:application-inference-profile/<id>
# JUDGE_COUNCIL_GLM_ARN=bedrock/arn:aws:bedrock:us-east-1:<acct>:application-inference-profile/<id>
# JUDGE_COUNCIL_KIMI_ARN=bedrock/arn:aws:bedrock:ap-south-1:<acct>:application-inference-profile/<id>
# For a custom roster, set JUDGE_COUNCIL_MEMBERS to a comma-separated list of
# family=arn entries (overrides the three vars above), e.g.:
# JUDGE_COUNCIL_MEMBERS=sonnet=bedrock/arn:...:profile/abc,glm=bedrock/arn:...:profile/def
# alias: AWS_BEARER_TOKEN_BEDROCK
KENSEI_AWS_BEARER_TOKEN=          # your Bedrock API key (bearer token)

# --- OpenAI (gpt-5.5 via LiteLLM) ---
# alias: OPENAI_API_KEY
KENSEI_OPENAI_API_KEY=

# --- GPT rubric judge (Channel B, opt-in) ---
# Dedicated OpenAI key + model id to run GPT (e.g. gpt-5.6) as a rubric judge,
# separate from KENSEI_OPENAI_API_KEY (the trajectory/agent key). When BOTH are
# set (and JUDGE_GPT_PRIMARY is not off) a single GPT judge grades ahead of the
# 3-model council, with the council as the no-signal fallback. Leaving them
# blank keeps the council as the sole Channel-B path (single-judge mode was
# removed in m1609).
# alias: JUDGE_GPT_API_KEY
KENSEI_JUDGE_GPT_API_KEY=
# alias: JUDGE_GPT_MODEL — e.g. gpt-5.6-sol / gpt-5.6-terra / gpt-5.6-luna.
# NOTE: on the metered/direct-OpenAI path a bare `gpt-5.6` is accepted, but the
# codex-subscription route (below) forwards the id verbatim and the codex backend
# rejects bare `gpt-5.6` — use an explicit -sol/-terra/-luna id there, or set
# KENSEI_JUDGE_CODEX_BRIDGE_MODEL.
KENSEI_JUDGE_GPT_MODEL=
# Kill switch: set to 0/false/no/off to force council-only even when the GPT
# judge is configured. Unset/anything-else = GPT judge enabled by default.
JUDGE_GPT_PRIMARY=

# --- Judge audio transcription (Channel B, host-side, offline) ---
# Judges accept no audio, so audio deliverables are transcribed on the HOST with
# a local sherpa-onnx model and sent as text. Optional host state, set up once:
#   bash script/setup_judge_asr.sh        (pip deps + ~480 MB model -> ~/.wcb/asr)
# Without it grading still works, but audio reaches the judge as a duration
# marker only; every batch logs "Judge ASR: ready|UNAVAILABLE" so that is visible.
# WCB_JUDGE_AUDIO_TRANSCRIBE=0          # kill switch (default on)
# WCB_JUDGE_ASR_MODEL_DIR=              # model dir override (default ~/.wcb/asr)
# WCB_JUDGE_ASR_THREADS=4               # CPU threads for transcription

# --- GPT rubric judge via ChatGPT/Codex subscription (Channel B, opt-in) ---
# Route the GPT judge through the codex OAuth bridge (the same ChatGPT
# subscription used for the codex trajectory backend) instead of a metered key,
# so the judge bills $0. Normally you do NOT set the URL by hand: running with
# --use-codex-oauth publishes the bridge on a host loopback port and exports
# KENSEI_JUDGE_CODEX_BRIDGE_URL automatically. Set it explicitly only to pin an
# external bridge. The bridge secret is WCB_CODEX_BRIDGE_SECRET (auto-generated
# per run if unset). Model defaults to gpt-5.6-sol; the evidence cap is the
# tunable safety valve for the undocumented subscription context window.
KENSEI_JUDGE_CODEX_BRIDGE_URL=
KENSEI_JUDGE_CODEX_BRIDGE_MODEL=
KENSEI_JUDGE_CODEX_MAX_EVIDENCE=
# Fixed host loopback port for the codex bridge publish (else a free one is
# picked per run). Set only if you need a stable port.
WCB_CODEX_BRIDGE_HOST_PORT=
# Skip the codex-judge preflight (host -> bridge -> chatgpt.com liveness probe
# run once per batch before the trajectory). 1/true/yes/on to skip.
WCB_SKIP_JUDGE_CODEX_PREFLIGHT=

# --- Judge image attachment budget (Channel B, GPT judge only) ---
# Agent HTML/markdown deliverables routinely inline proof screenshots as
# data:image/<mime>;base64,<...>. Those blobs are LIFTED out of the judge's text
# prompt (a placeholder naming the image is left behind) and re-attached as
# structured image content-parts, because as prompt text they both tripped a
# gpt-5.6 safety classifier (HTTP 200, empty content, stop_reason "refusal") and
# were unreadable to the judge anyway. Council members (sonnet/kimi/glm) stay
# text-only and are unaffected by all three settings below.
# Max image parts attached per judge request (default 8). 0 disables attachment
# entirely — placeholders still appear in the text, so nothing goes unmentioned.
KENSEI_JUDGE_MAX_IMAGES=
# Total base64 payload bytes attachable per judge request (default 4194304 = 4MB).
# Images past either cap keep their text placeholder and are not attached.
KENSEI_JUDGE_MAX_IMAGE_BYTES=
# Vision detail tier: auto (default — the endpoint picks: small images stay on
# the cheap tier, charts/screenshots get tiled so their labels are readable) |
# low (flat cheap tier, the pre-2026-09 behaviour) | high.
KENSEI_JUDGE_IMAGE_DETAIL=
# WHAT gets attached (all validated first — a 1x1, corrupt, SVG or otherwise
# undecodable image is never sent, because one bad image part 400s the whole
# request; oversized images are downscaled to 2048 px, not dropped):
#   inline data: URIs in text files, image FILES the agent delivered, image files
#   a page points at (<img src="chart.png">, ![](chart.png)), pictures embedded in
#   .docx/.pptx/.xlsx, and rendered PDF pages (rubric-named PDFs only).
# Agent scratch images (_scratch/..., _name.png, .name.png) are never attached
# unless the rubric names them. Cap priority: rubric-named files, then pictures
# inside documents, then loose image files. If the endpoint still rejects the
# images the request is retried once as text.
# Pictures attached per office document (default 4; 0 disables).
# WCB_JUDGE_OFFICE_MAX_IMAGES=4
# Rendered pages per rubric-named PDF (default 4; 0 disables).
# WCB_JUDGE_PDF_MAX_PAGES=4
# Codex image-probe retries before images are disabled for a batch (default 2).
# WCB_JUDGE_IMAGE_PROBE_RETRIES=2

# --- Whisper / audio transcription (via LiteLLM /v1/audio/transcriptions) ---
# Dedicated key for the whisper-1 (and gpt-4o-transcribe) routes the
# audio-extract skill uses. Optional: if left empty, transcription falls back
# to KENSEI_OPENAI_API_KEY above. Must be an OpenAI key with audio access.
# alias: OPENAI_WHISPER_API_KEY
KENSEI_OPENAI_WHISPER_API_KEY=

# --- First-party vendor model (OpenAI-compatible relay, via LiteLLM) ---
# When KENSEI_1P_API_KEY *and* KENSEI_1P_MODEL are both set, the sidecar
# registers an OpenAI-compatible upstream pointed at KENSEI_1P_BASE_URL and
# LiteLLM auto-enables. The harness-facing model id IS KENSEI_1P_MODEL, so
# select it with `--model <that id>`. Per the vendor onboarding guide, ALL
# inference params are kept at their defaults (no reasoning_effort/temperature/
# top_p/top_k overrides); litellm_settings.drop_params strips anything callers
# emit that the relay doesn't support (no structured output / parallel tools).
# alias: ONEP_API_KEY
KENSEI_1P_API_KEY=
# alias: ONEP_MODEL — must match exactly what the relay's /models returns
KENSEI_1P_MODEL=
# alias: ONEP_API_BASE_URL — optional; overrides the default relay endpoint
KENSEI_1P_BASE_URL=

# --- LiteLLM proxy (sidecar) ---
# aliases: KENSEI3_LITELLM_MASTER_KEY, LITELLM_MASTER_KEY
# Only read in master-key mode (see "sidecar inbound auth" below). Leaving it
# set is harmless; by default nothing sends it and the sidecar rejects it.
KENSEI_LITELLM_MASTER_KEY=sk-talos-litellm
# alias: LITELLM_PORT
KENSEI3_LITELLM_PORT=4000
# Model id used when --litellm is active and --model is not a sidecar id
LITELLM_DEFAULT_MODEL=claude-opus-4.7

# --- LiteLLM sidecar inbound auth ---
# Which credential the sidecar accepts from the containers on its network. This
# is also the per-run cost-attribution switch: the main agent tags its usage
# rows by carrying its run key as the bearer, so whatever the sidecar accepts
# decides whether that tag exists.
#
#   (leave both unset)            DEFAULT, run-key scoped. The sidecar carries no
#                                 master key and admits only the
#                                 wcb::<task_id>::<uuid4> key the runner minted
#                                 for that attempt. Every row is tagged, so
#                                 per-run cost is exact under --parallel and
#                                 under faketime.
#   WCB_SIDECAR_NO_MASTER_KEY=1   Same as the default. This used to mean "no
#                                 inbound auth at all" and was the only way to
#                                 get per-run attribution; the default now gives
#                                 the attribution without the open door, so the
#                                 line is a no-op kept for existing .env files.
#   WCB_SIDECAR_MASTER_KEY=1      Legacy shared-key auth, explicit opt-in. Every
#                                 run authenticates with the same master key, so
#                                 main-agent rows go out untagged and per-run
#                                 cost falls back to time-window matching, which
#                                 over-attributes under --parallel and is wrong
#                                 under faketime. run_batch warns loudly at batch
#                                 start when this is combined with --parallel >1.
#
# Residual risk in run-key mode: the check is on the SHAPE of the key, not on
# membership in the set this batch minted, so a container already on the
# per-batch docker network can mint a well-formed key of its own. That network
# is internal and holds only this batch's agent, mock and bridge containers, and
# a forged key's spend shows up under a run key that matches no attempt.
# WCB_SIDECAR_MASTER_KEY=1

# ===== Cost-estimate fallback rates (Codex / Claude Code harnesses) =====
# The Codex and Claude Code harnesses run outside the LiteLLM sidecar, so
# litellm.completion_cost() never sees their tokens. When the harness transcript
# does NOT report a provider cost, cost_usd is ESTIMATED from these per-million-
# token (MTok) rates. If left unset they default to 0 -> cost_usd is recorded as
# $0 for those runs. Set them to the published rates of the model you are running.
# Codex estimator subtracts cache_read+cache_write from input before pricing;
# Claude Code estimator prices the full input_tokens (no cache subtraction).
# Example (Claude Opus 4.6/4.7): input 5, output 25, cache_read 0.5, cache_write 6.25
# CODEX_INPUT_PRICE_PER_MTOK=
# CODEX_OUTPUT_PRICE_PER_MTOK=
# CODEX_CACHE_READ_PRICE_PER_MTOK=
# CODEX_CACHE_WRITE_PRICE_PER_MTOK=
# CLAUDECODE_INPUT_PRICE_PER_MTOK=
# CLAUDECODE_OUTPUT_PRICE_PER_MTOK=
# CLAUDECODE_CACHE_READ_PRICE_PER_MTOK=
# CLAUDECODE_CACHE_WRITE_PRICE_PER_MTOK=

# ===== Mock-API stack (101 services under environment/) =====
# Enable per run with --mock-stack ; agents reach each API at
# http://<mock-container>:<port> via injected *_API_URL env vars (builds kensei3-mocks:v1).

# ===== Skills (sourced from environment/skills/: *-connector + media skills) =====
# Required-API connectors auto-inject per task. These inject into EVERY task:
WILDCLAW_DEFAULT_SKILLS=video-frames,pdf-extract,audio-extract
# WILDCLAW_SKILLS_DIR=             # override skill catalog dir (default: environment/skills)

# ===== Harbor bundle (optional) =====
# MIN_HARBOR_SCORE=                # skip bundle export below this score

# ===== S3 trajectory-media upload (optional; default keeps media as local files) =====
UPLOAD_MEDIA_TO_S3=false
S3_BUCKET=
S3_PREFIX=WildClaw
S3_REGION=us-east-1
# aliases: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
KENSEI_S3_ACCESS_KEY_ID=
KENSEI_S3_SECRET_ACCESS_KEY=

# ===== Lobster profile env keys (for skills that need API keys) =====
# GEMINI_API_KEY=
# FIRECRAWL_API_KEY=
# EXA_API_KEY=

# ===== Odoo finance API: per-trajectory usage reporting =====
# Reporting is ON by default: config.py ships the staging base URL and the
# project defaults below, so every completed trajectory POSTs its token/cost
# breakdown to <base>/ethara_project/trajectory_usage/create after judging.
# Set WCB_FINANCE_API_URL to an EMPTY value to turn reporting off entirely.
# A bare hostname is accepted: https:// and /api/v1 are added when missing.
# Posting is fail-open: a finance outage logs a warning and never fails a run.
# Every payload is also written to <output_dir>/finance_usage.json and appended
# to <work_dir>/finance_usage.jsonl, so failed posts can be replayed.
# All keys below have matching --finance-* CLI flags, which take precedence.
# Values shown are the built-in defaults; uncomment only to override.
# WCB_FINANCE_API_URL=https://projects-stage.ethara.ai/api/v1
# WCB_FINANCE_API_TOKEN=            # sent as: Authorization: Bearer <token>; omitted if unset
# WCB_FINANCE_API_TIMEOUT=15        # seconds
# WCB_FINANCE_PROJECT_ID=KEN-123
# WCB_FINANCE_PROJECT_TYPE=Technical
# WCB_FINANCE_TEAM_TYPE=Projects
# Budget fields are mutually exclusive and normalised before sending:
# RFP clears production_mode, Production clears rfp_sub_type.
# is_phase_based is derived (true only when production mode is Multiphase).
# WCB_FINANCE_BUDGET_TYPE=Production      # RFP | Production
# WCB_FINANCE_RFP_SUB_TYPE=               # Testing | Sampling   (RFP budgets only)
# WCB_FINANCE_PRODUCTION_MODE=Singlephase # Singlephase | Multiphase  (Production budgets only)
# Left blank, subscription_id falls back to the uuid of the Claude account that
# generated the trajectory, read via the Claude Code OAuth login.
# WCB_FINANCE_SUBSCRIPTION_ID=      # e.g. SUB-98765

# ===== OAuth cost estimation, trajectory + judge (Bedrock model-card rates) =====
# Work run on the Claude Max OAuth subscription is prepaid, so it is recorded at
# ~$0: LiteLLM zeroes the OAuth model blocks for trajectories, and grading.py
# forces the Sonnet judge to $0 on the cc-bridge route. That is correct for
# usage.jsonl (real marginal spend) but useless for finance reporting, so the
# finance payload re-estimates from token counts using the Bedrock model card.
# Bedrock work always carries a real non-zero cost and is reported verbatim;
# only a $0 line is ever repriced, so Bedrock figures are never touched.
# Built-in cards (USD per MILLION tokens):
#   claude-opus-5 / claude-opus-4.7 / claude-opus-4-6   in 5.00  out 25.00  cache_read 0.50  cache_write 6.25
#   claude-fable-5                                      in 10.00 out 50.00  cache_read 1.00  cache_write 12.50
#   claude-sonnet-4-6 / claude-sonnet-4-5-* / sonnet    in 3.00  out 15.00  cache_read 0.30  cache_write 3.75
# The bare "sonnet" key is needed because a council member routed via Bedrock
# reports an ARN, which the finance layer replaces with the family key.
# Override one field of one model when a model card changes. The slug is the
# model id uppercased with every non-alphanumeric character turned into "_".
# Invalid or negative values are logged and ignored, never applied as zero.
# WCB_OAUTH_PRICE_CLAUDE_OPUS_5_INPUT_PER_MTOK=5
# WCB_OAUTH_PRICE_CLAUDE_OPUS_5_OUTPUT_PER_MTOK=25
# WCB_OAUTH_PRICE_CLAUDE_OPUS_5_CACHE_READ_PER_MTOK=0.5
# WCB_OAUTH_PRICE_CLAUDE_OPUS_5_CACHE_WRITE_PER_MTOK=6.25
# WCB_OAUTH_PRICE_CLAUDE_FABLE_5_OUTPUT_PER_MTOK=50
# WCB_OAUTH_PRICE_SONNET_INPUT_PER_MTOK=3
