#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# wcb — simple login/logout wrapper for the WildClawBench Claude-Max OAuth path
#
# WHY THIS EXISTS: running a trajectory on the Claude Max subscription requires a
# few OAuth env vars to be present. Typing/pasting them every time is error prone,
# so this wrapper turns them into a `login` / `logout` pair (like tasker):
#   * `login`  -> loads the OAuth vars from .env into your shell (subscription ON)
#   * `logout` -> unsets them (subscription OFF; a fresh login is required again)
#   * `run`    -> runs a trajectory via script/run.sh with the OAuth path + reps
#
# NO SECRETS ARE HARDCODED HERE. Every value is read from the repo .env file
# (the single source of truth). Edit .env to change the pool path / secret / ARN.
#
# IMPORTANT: `login` / `logout` must MUTATE YOUR CURRENT SHELL, so you have to
# SOURCE this script for those two subcommands:
#       source script/wcb login
#       source script/wcb logout
# `run` and `status` work either sourced or executed:
#       source script/wcb run input/kayla_morgan_9b8f1d3c-... --reps 3
# FIRST TIME ON A NEW MACHINE: run one command that extracts your Claude Max
# token from this OS's credential store (macOS Keychain, or on Linux the
# ~/.claude/.credentials.json file the `claude` CLI writes), writes .env + the
# pool file, and installs the wcb() shell function into your shell rc
# (~/.zshrc for zsh / ~/.bashrc for bash) automatically:
#       source script/wcb setup
#       source ~/.zshrc     # (or ~/.bashrc on Linux/bash — setup prints the exact file)
# then just:  wcb login   /   wcb run <task> --reps N   /   wcb logout
# ---------------------------------------------------------------------------

# Resolve the repo root from this script's own location (works sourced or run).
if [ -n "${BASH_SOURCE[0]:-}" ]; then _wcb_self="${BASH_SOURCE[0]}"; else _wcb_self="${(%):-%N}"; fi
_wcb_root="$(cd "$(dirname "$_wcb_self")/.." 2>/dev/null && pwd)"
_wcb_env="$_wcb_root/.env"

_wcb_ok()   { printf '\033[32m[wcb]\033[0m %s\n' "$*"; }
_wcb_warn() { printf '\033[33m[wcb]\033[0m %s\n' "$*"; }
_wcb_err()  { printf '\033[31m[wcb]\033[0m %s\n' "$*" >&2; }

# Read a single KEY=VALUE from .env (last match wins), stripped of surrounding
# quotes. Returns empty if the key is absent or commented out.
_wcb_env_get() {
    [ -f "$_wcb_env" ] || return 0
    local _line
    _line="$(grep -E "^[[:space:]]*$1=" "$_wcb_env" 2>/dev/null | tail -n1)"
    [ -n "$_line" ] || return 0
    _line="${_line#*=}"
    _line="${_line%\"}"; _line="${_line#\"}"
    _line="${_line%\'}"; _line="${_line#\'}"
    printf '%s' "$_line"
}

# ---------------------------------------------------------------------------
# OS credential store is the SOURCE OF TRUTH; the pool file is only a snapshot.
# ---------------------------------------------------------------------------
# Read the raw Claude-Code OAuth blob from THIS machine's OS credential store
# (macOS Keychain, or on Linux the plaintext file the `claude` CLI writes, with
# a secret-tool fallback). Prints the raw JSON on stdout, empty if none.
_wcb_read_os_creds() {
    local _svc="Claude Code-credentials" _os _raw=""
    _os="$(uname -s)"
    case "$_os" in
        Darwin) _raw="$(security find-generic-password -s "$_svc" -w 2>/dev/null)" ;;
        Linux)
            local _cf="$HOME/.claude/.credentials.json"
            [ -f "$_cf" ] && _raw="$(cat "$_cf" 2>/dev/null)"
            [ -z "$_raw" ] && command -v secret-tool >/dev/null 2>&1 && _raw="$(secret-tool lookup service "$_svc" 2>/dev/null)"
            ;;
    esac
    printf '%s' "$_raw"
}

# Decide whether the pool snapshot at $1 is still FRESH relative to the OS store.
# Returns 0 (fresh -> keep) or 1 (stale -> must resync). The pool is stale when:
#   * it is missing or not valid OAuth JSON (no accessToken), OR
#   * it is expired / within 5 min of expiry (expiresAt is epoch-ms), OR
#   * the OS store holds a DIFFERENT *and non-expired* accessToken than the
#     snapshot — this is the account-switch case: a user whose account hit its
#     cap re-logs into another account in the Claude app, the Keychain token
#     changes, and we must adopt it automatically (exhaustion is not encoded in
#     the blob, so "OS differs" is the only signal we can key on without extra
#     user steps). Tie-break (user m0181): prefer whichever token is non-expired,
#     so an expired/revoked OS token (common in the borrowed-subscription
#     "send auth link -> paste code" flow) never clobbers a still-valid pool.
# The OS blob is passed on stdin so we read the Keychain exactly once per call.
_wcb_pool_is_fresh() {
    local _pool_file="$1" _os_raw
    _os_raw="$(cat)"
    POOL_FILE="$_pool_file" OS_RAW="$_os_raw" python3 - <<'PY' 2>/dev/null
import json, os, sys, time

pool_path = os.environ.get("POOL_FILE", "")
os_raw = os.environ.get("OS_RAW", "")

def inner(blob):
    try:
        d = json.loads(blob)
    except Exception:
        return None
    if not isinstance(d, dict):
        return None
    return d.get("claudeAiOauth", d)

# Pool snapshot must exist and be valid.
try:
    with open(pool_path) as fh:
        pool = inner(fh.read())
except Exception:
    pool = None
if not pool or not pool.get("accessToken"):
    sys.exit(1)  # missing/invalid -> stale

# Expiry check (expiresAt is epoch milliseconds; 5 min leeway).
exp = pool.get("expiresAt")
try:
    if exp is not None and float(exp) <= (time.time() + 300) * 1000.0:
        sys.exit(1)  # expired / near-expiry -> stale
except (TypeError, ValueError):
    pass

# Account-switch check: if the OS store holds a DIFFERENT accessToken, adopt it
# ONLY when that OS token is itself non-expired. Tie-break rule (user m0181):
# prefer whichever token is non-expired. This matters for the borrowed-
# subscription flow (Claude Code "send auth link -> paste code"): the OS store
# can end up holding an expired/revoked token while the pool still holds a
# valid, refreshed one. Blindly adopting "OS differs" would clobber the good
# pool token with a dead OS token and then fail to refresh. So: only switch to
# the OS token if it is genuinely usable; if the OS copy is expired, keep the
# still-valid pool snapshot.
def _is_expired(node):
    e = node.get("expiresAt")
    try:
        return e is not None and float(e) <= (time.time() + 300) * 1000.0
    except (TypeError, ValueError):
        return False  # unknown expiry -> treat as usable

os_inner = inner(os_raw) if os_raw else None
if os_inner and os_inner.get("accessToken"):
    if os_inner.get("accessToken") != pool.get("accessToken"):
        if not _is_expired(os_inner):
            sys.exit(1)  # OS store changed to a USABLE token (account switch) -> stale
        # OS token differs but is expired: pool passed its own expiry check
        # above, so the pool is the fresher of the two -> keep it.

sys.exit(0)  # fresh -> keep
PY
}

# Write the OS-store OAuth blob (passed on stdin) into the pool file at $1,
# normalized to {"claudeAiOauth": {...}} and chmod 600. Returns non-zero on a
# missing/invalid payload so callers can surface an actionable error.
_wcb_write_pool_from_os() {
    local _pool_file="$1"
    mkdir -p "$(dirname "$_pool_file")"
    if python3 -c 'import sys,json;d=json.load(sys.stdin);inner=d.get("claudeAiOauth",d);assert inner.get("accessToken"),"no accessToken";json.dump({"claudeAiOauth":inner},open(sys.argv[1],"w"),indent=2)' "$_pool_file" 2>/dev/null; then
        chmod 600 "$_pool_file"
        return 0
    fi
    return 1
}

# Automatic, non-interactive resync used by setup AND login (so `wcb run`, which
# auto-logins, always adopts a fresh Claude-app login with NO extra commands).
# Fail-open: never abort the caller when the OS store is temporarily unreadable
# but a usable pool snapshot already exists.
_wcb_os_token_expired() {
    OS_RAW="$(cat)" python3 - <<'PY' 2>/dev/null
import json, os, sys, time
raw = os.environ.get("OS_RAW", "")
try:
    d = json.loads(raw)
    node = d.get("claudeAiOauth", d) if isinstance(d, dict) else {}
    exp = node.get("expiresAt")
    sys.exit(0 if (exp is not None and float(exp) <= time.time() * 1000.0) else 1)
except Exception:
    sys.exit(1)
PY
}

_wcb_ensure_pool_fresh() {
    local _pool_file="$1" _os_raw
    _os_raw="$(_wcb_read_os_creds)"
    if printf '%s' "$_os_raw" | _wcb_pool_is_fresh "$_pool_file"; then
        _wcb_ok "OAuth pool token is current -> $_pool_file"
        return 0
    fi
    if [ -n "$_os_raw" ] && printf '%s' "$_os_raw" | _wcb_os_token_expired \
        && ! printf '%s' "$_os_raw" | _wcb_pool_is_fresh "$_pool_file"; then
        _wcb_err "Your Claude login has EXPIRED (the token in this machine's Claude Code app is past its expiry)."
        _wcb_err "Open the Claude app (or run 'claude' in a terminal) and sign in again with your Max subscription,"
        _wcb_err "then re-run 'source script/wcb setup' (or just 'wcb run'). Nothing else is needed."
        return 1
    fi
    if [ -z "$_os_raw" ]; then
        # OS store unreadable. If we at least have some pool file, keep going
        # (fail-open); only hard-fail when there is nothing usable at all.
        if [ -f "$_pool_file" ]; then
            _wcb_warn "could not read OS credential store — keeping existing pool $_pool_file"
            return 0
        fi
        _wcb_err "no Claude Code credentials in this OS's store and no pool file."
        _wcb_err "Sign into the Claude Code app with your Max subscription, then re-run."
        return 1
    fi
    if printf '%s' "$_os_raw" | _wcb_write_pool_from_os "$_pool_file"; then
        _wcb_ok "refreshed OAuth pool from Claude login -> $_pool_file (chmod 600)"
        return 0
    fi
    # OS payload present but unusable; fall back to any existing snapshot.
    if [ -f "$_pool_file" ]; then
        _wcb_warn "OS credential payload invalid — keeping existing pool $_pool_file"
        return 0
    fi
    _wcb_err "Claude OAuth payload was not valid JSON and no pool file exists."
    _wcb_err "Re-authenticate in the Claude Code app, then re-run."
    return 1
}

_wcb_login() {
    if [ ! -f "$_wcb_env" ]; then
        _wcb_err "no .env found at $_wcb_env — cannot login"
        return 1
    fi
    local _use _pool _secret _stub _arn
    _use="$(_wcb_env_get WCB_USE_CLAUDE_OAUTH)"
    _pool="$(_wcb_env_get WCB_CC_ACCOUNT_POOL)"
    _secret="$(_wcb_env_get WCB_CC_BRIDGE_SECRET)"
    _stub="$(_wcb_env_get WCB_CC_STUB_KEY)"
    _arn="$(_wcb_env_get JUDGE_COUNCIL_SONNET_ARN)"

    # Per-laptop pool-path resolution (works for ANY user on ANY laptop):
    #   The .env may carry an absolute path baked on a different machine
    #   (e.g. /Users/apple/.wcb/oauth_pool/account_a.json). That path won't
    #   exist here, so we auto-fall-back to THIS machine's $HOME location,
    #   which is exactly where `wcb setup` writes the extracted Keychain token.
    #   Precedence: (1) $HOME pool if it exists -> always prefer it;
    #   (2) else the .env value if it exists; (3) else the $HOME default.
    local _home_pool="$HOME/.wcb/oauth_pool/account_a.json"
    case "$_pool" in
        default|keychain:*)
            : ;;  # non-file spec, leave as-is (resolved live by claude_oauth)
        *)
            # Prefer this machine's own pool file; only keep the .env path if
            # it actually exists here; otherwise fall back to the $HOME default.
            if [ -f "$_home_pool" ]; then
                _pool="$_home_pool"
            elif [ -z "$_pool" ] || [ ! -f "$_pool" ]; then
                _pool="$_home_pool"
            fi
            ;;
    esac

    if [ -z "$_secret" ]; then
        _wcb_err "WCB_CC_BRIDGE_SECRET missing in .env — run 'wcb setup' first"
        return 1
    fi
    # Pool spec may be a file path, "default", or "keychain:<service>".
    # For actual file-path specs, AUTOMATICALLY resync the snapshot from this
    # machine's OS credential store before use. This is what makes a fresh
    # Claude-app login (e.g. after switching accounts when one hits its cap) get
    # picked up on the very next `wcb run` with no extra commands. Non-file specs
    # are resolved live by src/utils/claude_oauth, so they need no snapshot.
    case "$_pool" in
        default|keychain:*) ;;
        *)
            _wcb_ensure_pool_fresh "$_pool" || return 1
            if [ ! -f "$_pool" ]; then
                _wcb_err "pool file missing: $_pool — cannot login"
                return 1
            fi
            ;;
    esac

    export WCB_USE_CLAUDE_OAUTH="${_use:-1}"
    export WCB_CC_ACCOUNT_POOL="$_pool"
    export WCB_CC_BRIDGE_SECRET="$_secret"
    # Pin the auth provider for this shell. Everything downstream (sidecar
    # branch, judge roster) reads this one value; the providers are independent
    # and never fall back to one another.
    export WCB_AUTH_PROVIDER="oauth"
    [ -n "$_stub" ] && export WCB_CC_STUB_KEY="$_stub"
    if [ -n "$_arn" ]; then
        export JUDGE_COUNCIL_SONNET_ARN="$_arn"
    fi

    _wcb_ok "logged in — Claude Max subscription ACTIVE"
    _wcb_ok "  WCB_AUTH_PROVIDER=$WCB_AUTH_PROVIDER (judge council: sonnet only)"
    _wcb_ok "  WCB_USE_CLAUDE_OAUTH=$WCB_USE_CLAUDE_OAUTH"
    _wcb_ok "  WCB_CC_ACCOUNT_POOL=$WCB_CC_ACCOUNT_POOL"
    _wcb_ok "  WCB_CC_STUB_KEY=$WCB_CC_STUB_KEY (bridge secret set, hidden)"
    if [ -n "$_arn" ]; then
        _wcb_ok "  JUDGE_COUNCIL_SONNET_ARN set (sonnet judge enabled)"
    fi
    return 0
}

_wcb_logout() {
    unset WCB_USE_CLAUDE_OAUTH WCB_CC_ACCOUNT_POOL WCB_CC_BRIDGE_SECRET WCB_CC_STUB_KEY
    unset JUDGE_COUNCIL_SONNET_ARN
    unset KENSEI_JUDGE_OAUTH_BRIDGE_URL KENSEI_JUDGE_USE_LITELLM
    # Back to the inferred default (Bedrock) rather than a stale 'oauth' pin.
    unset WCB_AUTH_PROVIDER
    _wcb_ok "logged out — subscription vars cleared (login again to re-enable)"
}

_wcb_status() {
    if [ "${WCB_USE_CLAUDE_OAUTH:-0}" = "1" ] && [ -n "${WCB_CC_ACCOUNT_POOL:-}" ]; then
        _wcb_ok "status: LOGGED IN (pool=$WCB_CC_ACCOUNT_POOL)"
    else
        _wcb_warn "status: LOGGED OUT — run 'source script/wcb login'"
    fi
    _wcb_status_provider
}

# Report the auth provider that a run would resolve to right now, mirroring
# auth_provider.resolve_provider(): explicit WCB_AUTH_PROVIDER wins, else infer
# from WCB_USE_CLAUDE_OAUTH + WCB_CC_ACCOUNT_POOL. The judge roster follows the
# provider, so it is printed alongside.
_wcb_status_provider() {
    local _p
    if [ -n "${WCB_AUTH_PROVIDER:-}" ]; then
        _p="$WCB_AUTH_PROVIDER"
    elif [ "${WCB_USE_CLAUDE_OAUTH:-0}" = "1" ] && [ -n "${WCB_CC_ACCOUNT_POOL:-}" ]; then
        _p="oauth (inferred)"
    else
        _p="bedrock (inferred)"
    fi
    case "$_p" in
        oauth*) _wcb_ok "auth provider: $_p — judge council: sonnet only" ;;
        *)      _wcb_ok "auth provider: $_p — judge council: sonnet + glm + kimi" ;;
    esac
}

_wcb_run() {
    # TUI path: `wcb run [task]` (or just `wcb <task-dir>`) opens the
    # full-screen config launcher (eval/wcb.py). Backend / model / OAuth
    # account / parallel workers / advanced options are all picked there;
    # streaming is always on and interactive mode is auto-detected from the
    # task layout — no flags to remember. Auto-logins from .env first so the
    # OAuth dropdown works without a separate `wcb login`.
    if [ "${WCB_USE_CLAUDE_OAUTH:-0}" != "1" ]; then
        _wcb_login || _wcb_warn "continuing without OAuth login (API key / Bedrock routing)"
    fi
    local _py="$_wcb_root/.venv/bin/python3"
    [ -x "$_py" ] || _py="$(command -v python3)"
    ( cd "$_wcb_root" && "$_py" eval/wcb.py "$@" )
}

# Pre-TUI batch path (script/run.sh + preflight + reps), kept for automation.
_wcb_run_legacy() {
    if [ "${WCB_USE_CLAUDE_OAUTH:-0}" != "1" ]; then
        _wcb_err "not logged in — run 'source script/wcb login' first"
        return 1
    fi
    local task="" model="claude-opus-4.7" reps="1"
    local -a extra=()
    while [ $# -gt 0 ]; do
        case "$1" in
            -r|--reps|--rep|--iter|--iterations|-k) reps="$2"; shift 2 ;;
            -m|--model) model="$2"; shift 2 ;;
            -t|--task) task="$2"; shift 2 ;;
            *)
                if [ -z "$task" ] && [ "${1#-}" = "$1" ]; then
                    task="$1"; shift
                else
                    extra+=("$1"); shift
                fi
                ;;
        esac
    done
    if [ -z "$task" ]; then
        _wcb_err "usage: wcb run <task> [--reps N] [--model M] [extra run.sh flags...]"
        return 1
    fi
    export PATH="$_wcb_root/.venv/bin:$PATH"
    ( cd "$_wcb_root" && ./script/run.sh --task "$task" --model "$model" --reps "$reps" \
        --backend openclaw --use-claude-oauth "${extra[@]}" )
}

# One-command per-laptop onboarding. Does everything a fresh machine needs so
# `wcb login` works without any manual mkdir / copy / path-editing:
#   1) extract this laptop's OWN Claude Code Max token from the macOS Keychain
#      into $HOME/.wcb/oauth_pool/account_a.json (chmod 600)
#   2) create .env from .env.example (if absent) and set the OAuth vars to
#      per-laptop values ($HOME pool path, a fresh local bridge secret, stub key)
#   3) install the `wcb()` shell function into ~/.zshrc pointing at THIS repo
# Safe to re-run (idempotent): it refreshes the token and only fills gaps.
_wcb_setup() {
    local _pool_dir="$HOME/.wcb/oauth_pool"
    local _pool_file="$_pool_dir/account_a.json"
    local _svc="Claude Code-credentials"
    local _os; _os="$(uname -s)"

    # --- 1) token from this machine's OS credential store ------------------
    # macOS: the `claude` CLI stores the blob in the Keychain -> read via
    #        `security`. Linux: the CLI writes ~/.claude/.credentials.json as a
    #        plaintext file (no keychain needed); fall back to `secret-tool`
    #        (Secret Service) if a desktop keyring holds it instead.
    local _raw=""
    case "$_os" in
        Darwin)
            _raw="$(security find-generic-password -s "$_svc" -w 2>/dev/null)"
            if [ -z "$_raw" ]; then
                _wcb_err "no Claude Code credentials in Keychain (service '$_svc')."
                _wcb_err "Sign into the Claude Code app with your Max subscription first, then re-run 'wcb setup'."
                return 1
            fi
            ;;
        Linux)
            local _cred_file="$HOME/.claude/.credentials.json"
            if [ -f "$_cred_file" ]; then
                _raw="$(cat "$_cred_file" 2>/dev/null)"
            fi
            if [ -z "$_raw" ] && command -v secret-tool >/dev/null 2>&1; then
                _raw="$(secret-tool lookup service "$_svc" 2>/dev/null)"
            fi
            if [ -z "$_raw" ]; then
                _wcb_err "no Claude Code credentials found on this Linux machine."
                _wcb_err "Expected $_cred_file (written by the 'claude' CLI on login)."
                _wcb_err "Sign in with your Max subscription first:  claude   (then log in), then re-run 'wcb setup'."
                return 1
            fi
            ;;
        *)
            _wcb_err "unsupported OS for 'wcb setup': $_os (only Darwin/Linux)."
            _wcb_err "Provide credentials manually via WCB_CC_CREDS_PATH or CLAUDE_CODE_CREDENTIALS."
            return 1
            ;;
    esac
    mkdir -p "$_pool_dir"
    # Freshness-aware: the OS credential store is the source of truth. Keep the
    # existing snapshot ONLY when it still matches a non-expired OS-store token;
    # otherwise adopt the current login automatically (covers token rotation,
    # expiry, AND account-switch after a cap is hit). We already read the OS blob
    # into $_raw above, so pass it straight to the freshness check to avoid a
    # second Keychain read.
    if printf '%s' "$_raw" | _wcb_pool_is_fresh "$_pool_file"; then
        _wcb_ok "existing OAuth pool token is current -> keeping $_pool_file"
    elif printf '%s' "$_raw" | _wcb_write_pool_from_os "$_pool_file"; then
        _wcb_ok "wrote OAuth token from current Claude login -> $_pool_file (chmod 600)"
    elif [ -f "$_pool_file" ]; then
        _wcb_warn "OS credential payload invalid — keeping existing pool $_pool_file"
    else
        _wcb_err "no valid Claude OAuth token available (Keychain payload invalid AND no pool file)."
        _wcb_err "Re-authenticate in the Claude Code app / 'claude' CLI, then re-run."
        return 1
    fi

    # --- 2) .env with per-laptop values ------------------------------------
    if [ ! -f "$_wcb_env" ]; then
        if [ -f "$_wcb_root/.env.example" ]; then
            cp "$_wcb_root/.env.example" "$_wcb_env"
            _wcb_ok "created .env from .env.example"
        else
            : > "$_wcb_env"
            _wcb_warn "no .env.example found — created empty .env"
        fi
    fi
    # Ensure a KEY=VALUE line exists (replace any existing, commented or not).
    _wcb_set_env() {
        local _k="$1" _v="$2"
        # strip any existing definition (commented or active), then append.
        grep -vE "^[[:space:]]*#?[[:space:]]*$_k=" "$_wcb_env" > "$_wcb_env.tmp" 2>/dev/null || : > "$_wcb_env.tmp"
        printf '%s=%s\n' "$_k" "$_v" >> "$_wcb_env.tmp"
        mv "$_wcb_env.tmp" "$_wcb_env"
    }
    _wcb_set_env WCB_USE_CLAUDE_OAUTH 1
    _wcb_set_env WCB_CC_ACCOUNT_POOL "$_pool_file"
    _wcb_set_env WCB_CC_STUB_KEY "$(_wcb_env_get WCB_CC_STUB_KEY || true)"
    # stub key: default if empty
    [ -n "$(_wcb_env_get WCB_CC_STUB_KEY)" ] || _wcb_set_env WCB_CC_STUB_KEY sk-wcb-oauth-stub
    # bridge secret: keep existing, else generate a fresh per-laptop local secret.
    local _sec; _sec="$(_wcb_env_get WCB_CC_BRIDGE_SECRET)"
    if [ -z "$_sec" ]; then
        _sec="$(openssl rand -hex 32 2>/dev/null)"
        [ -n "$_sec" ] || _sec="$(python3 -c 'import secrets;print(secrets.token_hex(32))')"
        _wcb_set_env WCB_CC_BRIDGE_SECRET "$_sec"
        _wcb_ok "generated a fresh local WCB_CC_BRIDGE_SECRET"
    else
        _wcb_ok "kept existing WCB_CC_BRIDGE_SECRET"
    fi
    # sonnet judge ARN (a label only; the judge runs on the same subscription):
    # keep any existing value, else seed the known default so the judge is on.
    local _arn; _arn="$(_wcb_env_get JUDGE_COUNCIL_SONNET_ARN)"
    if [ -z "$_arn" ]; then
        _wcb_set_env JUDGE_COUNCIL_SONNET_ARN "bedrock/arn:aws:bedrock:ap-south-1:426628337772:application-inference-profile/urg0zifsjiga"
        _wcb_ok "seeded default JUDGE_COUNCIL_SONNET_ARN (sonnet judge enabled)"
    fi
    _wcb_ok "updated .env with per-laptop OAuth values"

    # --- 2b) Python venv + deps (needed by run.sh, which calls bare python3) --
    if [ ! -x "$_wcb_root/.venv/bin/python3" ]; then
        _wcb_warn "no .venv found — creating one (this is a one-time step)"
        # Prefer a modern Python (3.10+); bare python3 may be 3.9, which builds a
        # broken venv (incompatible litellm/pytest) -> every run silently scores 0.
        _wcb_py="$(command -v python3.12 || command -v python3.11 || command -v python3.13 || command -v python3)"
        if "$_wcb_py" -m venv "$_wcb_root/.venv" 2>/dev/null; then
            if [ -f "$_wcb_root/requirements.txt" ]; then
                "$_wcb_root/.venv/bin/python3" -m pip install -q --upgrade pip >/dev/null 2>&1
                if "$_wcb_root/.venv/bin/python3" -m pip install -q -r "$_wcb_root/requirements.txt" >/dev/null 2>&1; then
                    _wcb_ok "created .venv and installed requirements.txt"
                else
                    _wcb_warn ".venv created but 'pip install -r requirements.txt' failed — run it manually"
                fi
            else
                _wcb_warn ".venv created but no requirements.txt found — install deps manually"
            fi
        else
            _wcb_warn "could not create .venv — ensure python3 (3.10+) is installed"
        fi
    else
        _wcb_ok ".venv present"
    fi

    # --- 2c) cc-bridge docker image (the OAuth proxy container) --------------
    # Freshness-aware: the Dockerfile COPYs the bridge source at build time, so
    # rebuild whenever that source changed (not just when the image is absent).
    if command -v docker >/dev/null 2>&1; then
        if _wcb_ccbridge_image_fresh; then
            _wcb_ok "cc-bridge image $_WCB_CCBRIDGE_IMAGE present and current"
        else
            if _wcb_image_present "$_WCB_CCBRIDGE_IMAGE"; then
                _wcb_warn "cc-bridge image out of date vs bridge source — rebuilding (~1 min)"
            else
                _wcb_warn "cc-bridge image missing — building (one-time, ~1 min)"
            fi
            if _wcb_ccbridge_build; then
                _wcb_ok "built $_WCB_CCBRIDGE_IMAGE"
            else
                _wcb_warn "cc-bridge build failed — build manually: docker build -f docker/cc-bridge/Dockerfile -t $_WCB_CCBRIDGE_IMAGE ."
            fi
        fi
    else
        if [ "$_os" = "Darwin" ]; then
            _wcb_warn "docker not found on PATH — install Docker Desktop before running a task"
        else
            _wcb_warn "docker not found on PATH — install Docker Engine before running a task (e.g. 'apt-get install docker.io')"
        fi
    fi

    # --- 3) shell-rc wcb() function pointing at THIS repo -----------------
    # Pick the rc file for THIS machine's login shell: zsh -> ~/.zshrc (macOS
    # default), bash -> ~/.bashrc (Linux default). Falls back by OS if $SHELL
    # is unset. This is what makes `wcb ...` work without the `source` prefix.
    local _rc
    case "${SHELL:-}" in
        */zsh)  _rc="$HOME/.zshrc" ;;
        */bash) _rc="$HOME/.bashrc" ;;
        *)      if [ "$_os" = "Darwin" ]; then _rc="$HOME/.zshrc"; else _rc="$HOME/.bashrc"; fi ;;
    esac
    local _fn="wcb() { source \"$_wcb_root/script/wcb\" \"\$@\"; }"
    touch "$_rc"
    grep -vE '^[[:space:]]*wcb\(\)' "$_rc" > "$_rc.tmp" 2>/dev/null || : > "$_rc.tmp"
    printf '%s\n' "$_fn" >> "$_rc.tmp"
    mv "$_rc.tmp" "$_rc"
    _wcb_ok "installed wcb() in $_rc -> $_wcb_root/script/wcb"

    _wcb_ok "setup complete. Now run:  source $_rc  &&  wcb login"
}

# ===========================================================================
# wcb install — hardened, self-healing, one-terminal onboarding
# ---------------------------------------------------------------------------
# A superset of `wcb setup`: same end-state, but every blocker is
# detect -> auto-remediate -> re-check -> actionable-error-as-last-resort,
# and it ALSO provisions the docker images `wcb run` needs (agent / mock /
# optional headroom) which plain `setup` never did. When SOURCED it defines
# wcb() in the live shell so `source script/wcb install; wcb run` works in the
# SAME terminal — no new shell, no `source ~/.zshrc`.
#
# Sourced-safety: NEVER calls `exit` and NEVER enables errexit (this file is
# sourced into the user's interactive shell — a hard exit would close their
# terminal and errexit would kill it on the first failed probe). Everything
# returns explicit codes.
#
# Flags:  --skip-images   provision nothing docker-heavy (venv/.env/oauth only)
#         --headroom      also build the litellm-headroom image
#         --force         re-extract OAuth token even if the pool already valid
#         --offline       never reach the network (no rustup/brew/hf/pip-index)
# ===========================================================================

# --- image / path constants (mirrors root+script run.sh; single source here) --
_WCB_AGENT_IMAGE="wildclawbench-ubuntu:v1.3"
_WCB_AGENT_IMAGE_SHA="60eec8752cb597e180780ff08d7569c1892c169521f1f2b069c2efeb006a4078"
_WCB_AGENT_TAR="Images/wildclawbench-ubuntu_v1.3.tar"
_WCB_MOCK_IMAGE="kensei3-mocks:v1"
_WCB_HEADROOM_IMAGE="wildclawbench-litellm-headroom:v2"
_WCB_CCBRIDGE_IMAGE="wildclawbench-cc-bridge:v1"
_WCB_MIN_RUSTC="1.94.1"

# Robust "is this image present?" test. `docker image inspect <name:tag>` can
# miss an image the containerd/snapshotter store still lists (stale reference
# index), so fall back to matching `docker images` repo:tag output.
_wcb_image_present() {
    local _ref="$1"
    docker image inspect "$_ref" >/dev/null 2>&1 && return 0
    docker images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null | grep -qxF "$_ref"
}

# Content hash of the cc-bridge build inputs (bridge source + Dockerfile). The
# Dockerfile COPYs src/utils/claude_oauth into the image at BUILD time, so a
# presence-only check silently ships a STALE image after any bridge edit
# (root cause of the OAuth empty-thinking run_3 incident: a fixed bridge.py
# never reached the running Aug-4 image). We bake this hash into the image as a
# label and rebuild whenever the source hash differs.
_wcb_ccbridge_src_hash() {
    { find "$_wcb_root/src/utils/claude_oauth" -type f -name '*.py' -not -path '*/__pycache__/*' -print0 2>/dev/null \
        | LC_ALL=C sort -z | xargs -0 cat 2>/dev/null; \
      cat "$_wcb_root/docker/cc-bridge/Dockerfile" 2>/dev/null; } \
    | { shasum -a 256 2>/dev/null || sha256sum 2>/dev/null; } | cut -d' ' -f1
}

# Fresh iff the image exists AND its baked wcb.ccbridge.srchash label matches
# the current source hash. Empty label (older image) or mismatch => not fresh.
_wcb_ccbridge_image_fresh() {
    _wcb_image_present "$_WCB_CCBRIDGE_IMAGE" || return 1
    local _want _have
    _want="$(_wcb_ccbridge_src_hash)"
    [ -n "$_want" ] || return 0
    _have="$(docker image inspect "$_WCB_CCBRIDGE_IMAGE" \
        --format '{{ index .Config.Labels "wcb.ccbridge.srchash" }}' 2>/dev/null)"
    [ "$_have" = "$_want" ]
}

# Build the cc-bridge image, baking the current source hash as a label. All
# callers must use this so the freshness label stays in sync with the content.
_wcb_ccbridge_build() {
    local _hash
    _hash="$(_wcb_ccbridge_src_hash)"
    ( cd "$_wcb_root" && docker build \
        -f docker/cc-bridge/Dockerfile \
        --label "wcb.ccbridge.srchash=$_hash" \
        -t "$_WCB_CCBRIDGE_IMAGE" . >/dev/null 2>&1 )
}

# Install-run flags (set by _wcb_install arg parse; read by helpers).
_WCB_INSTALL_SKIP_IMAGES=0
_WCB_INSTALL_HEADROOM=0
_WCB_INSTALL_FORCE=0
_WCB_INSTALL_OFFLINE=0

# Progress state (weighted 9-phase stepped bar).
_WCB_PHASE_TOTAL=9
_WCB_PHASE_N=0
_wcb_is_tty() { [ -t 1 ]; }
# Print a phase banner. TTY -> a filled/empty block bar; non-TTY -> plain text.
_wcb_phase() {
    _WCB_PHASE_N=$((_WCB_PHASE_N + 1))
    local _label="$1" _n="$_WCB_PHASE_N" _t="$_WCB_PHASE_TOTAL"
    if _wcb_is_tty; then
        local _i _bar="" _filled="$_n"
        for _i in $(seq 1 "$_t"); do
            if [ "$_i" -le "$_filled" ]; then _bar="$_bar#"; else _bar="$_bar-"; fi
        done
        printf '\033[36m[wcb]\033[0m \033[1m[%s]\033[0m phase %s/%s: %s\n' "$_bar" "$_n" "$_t" "$_label"
    else
        printf '[wcb] [step %s/%s] %s\n' "$_n" "$_t" "$_label"
    fi
}

# Generic self-healing gate: run <check_fn>; if it fails, run <fix_fn> and
# re-check; only on a still-failing re-check do we surface the actionable
# error (already emitted by the fix_fn as its last line). Returns 0/1.
#   _wcb_ensure <check_fn> <fix_fn> <label>
# Any function name may be empty ("") to skip that stage (e.g. no fixer).
_wcb_ensure() {
    local _check="$1" _fix="$2" _label="$3"
    if "$_check" 2>/dev/null; then
        _wcb_ok "$_label: ok"
        return 0
    fi
    if [ -n "$_fix" ]; then
        _wcb_warn "$_label: missing/degraded — attempting auto-remediation"
        "$_fix"
        if "$_check" 2>/dev/null; then
            _wcb_ok "$_label: remediated"
            return 0
        fi
    fi
    _wcb_err "$_label: could NOT be auto-resolved (see hint above)"
    return 1
}

# ---- disk precheck (non-fatal warn) ---------------------------------------
_wcb_check_disk() {
    # Warn (never fail) if the repo volume has < 20 GiB free — the agent image
    # alone is ~13 GiB, so a fresh load needs headroom.
    local _avail_kb
    _avail_kb="$(df -Pk "$_wcb_root" 2>/dev/null | awk 'NR==2{print $4}')"
    [ -n "$_avail_kb" ] || return 0
    if [ "$_avail_kb" -lt 20971520 ]; then
        _wcb_warn "low disk: only $((_avail_kb/1048576)) GiB free on repo volume (agent image needs ~13 GiB)"
    fi
    return 0
}

# ---- pv (progress tool) — install if missing, tolerate failure -------------
_wcb_check_pv() { command -v pv >/dev/null 2>&1; }
_wcb_fix_pv() {
    [ "$_WCB_INSTALL_OFFLINE" = "1" ] && { _wcb_warn "pv missing (offline) — progress bars degrade to plain output"; return 0; }
    case "$(uname -s)" in
        Darwin) command -v brew >/dev/null 2>&1 && brew install pv >/dev/null 2>&1 || true ;;
        Linux)
            if sudo -n true 2>/dev/null; then
                if   command -v apt-get >/dev/null 2>&1; then sudo -n apt-get install -y pv >/dev/null 2>&1 || true
                elif command -v dnf     >/dev/null 2>&1; then sudo -n dnf install -y pv >/dev/null 2>&1 || true
                elif command -v yum     >/dev/null 2>&1; then sudo -n yum install -y pv >/dev/null 2>&1 || true
                elif command -v apk     >/dev/null 2>&1; then sudo -n apk add pv >/dev/null 2>&1 || true
                fi
            fi
            ;;
    esac
    _wcb_check_pv || _wcb_warn "pv unavailable — heavy loads will run without a progress bar (harmless)"
    return 0
}

# ---- rustc >= 1.94.1 (litellm wheel needs it) ------------------------------
# Compare current rustc against _WCB_MIN_RUSTC. Return 0 iff present AND new
# enough. This is what makes the pip step succeed on a fresh box.
_wcb_check_rustc() {
    command -v rustc >/dev/null 2>&1 || return 1
    local _have _min
    _have="$(rustc --version 2>/dev/null | awk '{print $2}')"
    [ -n "$_have" ] || return 1
    _min="$_WCB_MIN_RUSTC"
    # version-sort: if the smaller of {have,min} is min, then have>=min.
    [ "$(printf '%s\n%s\n' "$_have" "$_min" | sort -V | head -n1)" = "$_min" ]
}
_wcb_fix_rustc() {
    if [ "$_WCB_INSTALL_OFFLINE" = "1" ]; then
        _wcb_err "rustc >= $_WCB_MIN_RUSTC required for the litellm wheel but --offline set."
        _wcb_err "Install/upgrade Rust manually: https://rustup.rs  then re-run 'wcb install'."
        return 1
    fi
    # Prefer bumping an existing rustup toolchain; else bootstrap rustup.
    if command -v rustup >/dev/null 2>&1; then
        _wcb_warn "upgrading Rust toolchain via 'rustup update stable'"
        rustup update stable >/dev/null 2>&1 || true
    else
        _wcb_warn "installing Rust via rustup (needed to build the litellm wheel)"
        curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs 2>/dev/null | sh -s -- -y >/dev/null 2>&1 || true
        # Make the freshly-installed toolchain visible in THIS shell.
        [ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env" 2>/dev/null || true
    fi
    # Ensure ~/.cargo/bin is on PATH for the rest of this install.
    case ":$PATH:" in *":$HOME/.cargo/bin:"*) : ;; *) [ -d "$HOME/.cargo/bin" ] && export PATH="$HOME/.cargo/bin:$PATH" ;; esac
    if ! _wcb_check_rustc; then
        _wcb_err "rustc still < $_WCB_MIN_RUSTC after remediation. Upgrade manually (https://rustup.rs) then re-run 'wcb install'."
    fi
    return 0
}

# ---- a suitable python interpreter for the venv (3.10+, not 3.14) ----------
# Resolve the best python and stash it in _WCB_PYBIN. Prefer 3.12/3.11/3.13.
_WCB_PYBIN=""
_wcb_check_python() {
    local _c
    for _c in python3.12 python3.11 python3.13; do
        if command -v "$_c" >/dev/null 2>&1; then _WCB_PYBIN="$(command -v "$_c")"; return 0; fi
    done
    # Fall back to bare python3 ONLY if it is 3.10–3.13 (avoid 3.14 pin breaks / <3.10).
    if command -v python3 >/dev/null 2>&1; then
        local _v; _v="$(python3 -c 'import sys;print("%d.%d"%sys.version_info[:2])' 2>/dev/null)"
        case "$_v" in
            3.10|3.11|3.12|3.13) _WCB_PYBIN="$(command -v python3)"; return 0 ;;
        esac
    fi
    return 1
}
_wcb_fix_python() {
    if [ "$_WCB_INSTALL_OFFLINE" = "1" ]; then
        _wcb_err "no suitable Python (3.10–3.13) found and --offline set — install Python 3.12 manually."
        return 1
    fi
    case "$(uname -s)" in
        Darwin) command -v brew >/dev/null 2>&1 && { _wcb_warn "installing python@3.12 via Homebrew"; brew install python@3.12 >/dev/null 2>&1 || true; } ;;
        Linux)
            if sudo -n true 2>/dev/null; then
                if   command -v apt-get >/dev/null 2>&1; then sudo -n apt-get install -y python3.12 python3.12-venv >/dev/null 2>&1 || true
                elif command -v dnf     >/dev/null 2>&1; then sudo -n dnf install -y python3.12 >/dev/null 2>&1 || true
                fi
            fi
            # pyenv as a last resort if it is already installed.
            if ! _wcb_check_python && command -v pyenv >/dev/null 2>&1; then
                pyenv install -s 3.12 >/dev/null 2>&1 || true
            fi
            ;;
    esac
    _wcb_check_python || _wcb_err "could not obtain Python 3.10–3.13 automatically. Install python3.12 then re-run 'wcb install'."
    return 0
}

# ---- .venv with requirements installed -------------------------------------
# A "good" venv = the interpreter is executable AND litellm+textual import.
_wcb_check_venv() {
    local _py="$_wcb_root/.venv/bin/python3"
    [ -x "$_py" ] || return 1
    "$_py" -c 'import litellm, textual' >/dev/null 2>&1
}
_wcb_fix_venv() {
    local _py="$_wcb_root/.venv/bin/python3"
    # (1) create the venv if the interpreter is missing or unusable.
    if [ ! -x "$_py" ]; then
        _wcb_check_python || { _wcb_err "no python to build .venv"; return 1; }
        _wcb_warn "creating .venv with $_WCB_PYBIN"
        "$_WCB_PYBIN" -m venv "$_wcb_root/.venv" >/dev/null 2>&1 || {
            _wcb_warn ".venv looked corrupt — recreating from scratch"
            rm -rf "$_wcb_root/.venv"
            "$_WCB_PYBIN" -m venv "$_wcb_root/.venv" >/dev/null 2>&1 || { _wcb_err "python -m venv failed — check your Python install"; return 1; }
        }
    fi
    [ -x "$_py" ] || { _wcb_err ".venv/bin/python3 still absent after create"; return 1; }
    [ -f "$_wcb_root/requirements.txt" ] || { _wcb_err "requirements.txt not found at repo root"; return 1; }
    # (2) ensure the rust toolchain is new enough BEFORE building wheels.
    _wcb_ensure _wcb_check_rustc _wcb_fix_rustc "rustc>=$_WCB_MIN_RUSTC" || \
        _wcb_warn "proceeding to pip despite rustc check — a prebuilt wheel may still exist"
    "$_py" -m pip install -q --upgrade pip >/dev/null 2>&1 || true
    local _idx=""; [ "$_WCB_INSTALL_OFFLINE" = "1" ] && _idx="--no-index"
    # (3) tiered pip install: normal -> binary-only -> no-cache. Each re-checks.
    _wcb_warn "installing requirements.txt into .venv (this can take a few minutes)"
    if "$_py" -m pip install $_idx -r "$_wcb_root/requirements.txt" >/dev/null 2>&1; then :; 
    elif [ "$_WCB_INSTALL_OFFLINE" != "1" ] && "$_py" -m pip install --prefer-binary -r "$_wcb_root/requirements.txt" >/dev/null 2>&1; then
        _wcb_warn "installed with --prefer-binary (avoided a source build)"
    elif [ "$_WCB_INSTALL_OFFLINE" != "1" ] && "$_py" -m pip install --no-cache-dir -r "$_wcb_root/requirements.txt" >/dev/null 2>&1; then
        _wcb_warn "installed with --no-cache-dir (retried after a cache miss)"
    else
        _wcb_err "pip install -r requirements.txt FAILED. Most common cause: the litellm wheel needs rustc>=$_WCB_MIN_RUSTC."
        _wcb_err "Fix Rust (https://rustup.rs / 'rustup update stable') then re-run 'wcb install'; or inspect: $_py -m pip install -r requirements.txt"
        return 1
    fi
    return 0
}

# ---- .venv Python version advisory -----------------------------------------
# The launcher TUI (src/utils/ui/tui.py) and some deps are happiest on Python
# 3.12+. Older interpreters (<=3.11) parse f-strings more strictly and have
# tripped `wcb run` on real machines. This is a NON-fatal heads-up only: if the
# .venv already imports litellm+textual we do not rebuild it, so warn loudly and
# tell the user how to upgrade if they hit trouble.
_wcb_warn_venv_pyver() {
    local _py="$_wcb_root/.venv/bin/python3"
    [ -x "$_py" ] || return 0
    local _v; _v="$("$_py" -c 'import sys;print("%d.%d"%sys.version_info[:2])' 2>/dev/null)"
    [ -n "$_v" ] || return 0
    local _major="${_v%%.*}" _minor="${_v#*.}"
    # Warn when the venv Python is older than 3.12 (i.e. 3.x where x < 12).
    if [ "$_major" = "3" ] && [ "$_minor" -lt 12 ] 2>/dev/null; then
        _wcb_warn ".venv uses Python $_v; 3.12+ is recommended (older versions have tripped the 'wcb run' TUI)."
        _wcb_warn "If 'wcb run' errors on launch, rebuild the venv with 3.12: rm -rf .venv && wcb install"
    fi
    return 0
}

# ---- OAuth pool (freshness-aware: resync from OS store when stale) ----------
_WCB_POOL_DIR="$HOME/.wcb/oauth_pool"
_WCB_POOL_FILE="$_WCB_POOL_DIR/account_a.json"
# Fresh iff the snapshot still matches a current (non-expired) OS-store token.
# Reads the OS store live so an account-switch in the Claude app is detected.
_wcb_check_oauth() {
    [ -f "$_WCB_POOL_FILE" ] || return 1
    _wcb_read_os_creds | _wcb_pool_is_fresh "$_WCB_POOL_FILE"
}
_wcb_fix_oauth() {
    # Adopt the current Claude login from this OS's credential store. Fail-open:
    # keep a usable existing snapshot if the OS store is momentarily unreadable.
    _wcb_ensure_pool_fresh "$_WCB_POOL_FILE"
}

# ---- .env with the required OAuth secrets ----------------------------------
_wcb_check_env() {
    [ -f "$_wcb_env" ] || return 1
    [ -n "$(_wcb_env_get WCB_CC_BRIDGE_SECRET)" ] && \
    [ -n "$(_wcb_env_get WCB_CC_ACCOUNT_POOL)" ] && \
    [ "$(_wcb_env_get WCB_USE_CLAUDE_OAUTH)" = "1" ]
}
_wcb_fix_env() {
    if [ ! -f "$_wcb_env" ]; then
        if [ -f "$_wcb_root/.env.example" ]; then cp "$_wcb_root/.env.example" "$_wcb_env"; _wcb_ok "created .env from .env.example"
        else : > "$_wcb_env"; _wcb_warn "no .env.example — created empty .env"; fi
    fi
    _wcb_set_env() {
        local _k="$1" _v="$2"
        grep -vE "^[[:space:]]*#?[[:space:]]*$_k=" "$_wcb_env" > "$_wcb_env.tmp" 2>/dev/null || : > "$_wcb_env.tmp"
        printf '%s=%s\n' "$_k" "$_v" >> "$_wcb_env.tmp"
        mv "$_wcb_env.tmp" "$_wcb_env"
    }
    _wcb_set_env WCB_USE_CLAUDE_OAUTH 1
    _wcb_set_env WCB_CC_ACCOUNT_POOL "$_WCB_POOL_FILE"
    [ -n "$(_wcb_env_get WCB_CC_STUB_KEY)" ] || _wcb_set_env WCB_CC_STUB_KEY sk-wcb-oauth-stub
    local _sec; _sec="$(_wcb_env_get WCB_CC_BRIDGE_SECRET)"
    if [ -z "$_sec" ]; then
        _sec="$(openssl rand -hex 32 2>/dev/null)"
        [ -n "$_sec" ] || _sec="$(python3 -c 'import secrets;print(secrets.token_hex(32))' 2>/dev/null)"
        _wcb_set_env WCB_CC_BRIDGE_SECRET "$_sec"
        _wcb_ok "generated a fresh local WCB_CC_BRIDGE_SECRET"
    fi
    local _arn; _arn="$(_wcb_env_get JUDGE_COUNCIL_SONNET_ARN)"
    [ -n "$_arn" ] || _wcb_set_env JUDGE_COUNCIL_SONNET_ARN "bedrock/arn:aws:bedrock:ap-south-1:426628337772:application-inference-profile/urg0zifsjiga"
    _wcb_ok "updated .env with per-laptop OAuth values"
    return 0
}

# ---- git-lfs pointers resolved (Images/ + data blobs) ----------------------
_wcb_check_lfs() {
    # Only a concern if the repo actually uses LFS. If there's no .gitattributes
    # LFS filter or git-lfs isn't installed, treat as satisfied (nothing to do).
    command -v git >/dev/null 2>&1 || return 0
    git -C "$_wcb_root" lfs env >/dev/null 2>&1 || return 0
    # Unresolved pointers show up as tiny "version https://git-lfs" files.
    ! git -C "$_wcb_root" lfs status 2>/dev/null | grep -q '(.*pointer.*)'
}
_wcb_fix_lfs() {
    [ "$_WCB_INSTALL_OFFLINE" = "1" ] && { _wcb_warn "LFS pointers unresolved but --offline set — skipping pull"; return 0; }
    command -v git >/dev/null 2>&1 || { _wcb_warn "git not found — cannot resolve LFS pointers"; return 0; }
    _wcb_warn "resolving git-lfs pointers (git lfs install + pull)"
    git -C "$_wcb_root" lfs install >/dev/null 2>&1 || true
    git -C "$_wcb_root" lfs pull >/dev/null 2>&1 || _wcb_warn "git lfs pull did not complete — large assets may be missing"
    return 0
}

# ---- docker daemon up ------------------------------------------------------
_wcb_check_dockerd() { command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; }
_wcb_fix_dockerd() {
    command -v docker >/dev/null 2>&1 || {
        if [ "$(uname -s)" = "Darwin" ]; then _wcb_err "docker not installed — install Docker Desktop (https://www.docker.com/products/docker-desktop) then re-run 'wcb install'."
        else _wcb_err "docker not installed — install Docker Engine (e.g. 'apt-get install docker.io') then re-run 'wcb install'."; fi
        return 1
    }
    if [ "$(uname -s)" = "Darwin" ]; then
        _wcb_warn "docker daemon down — launching Docker Desktop"
        open -a Docker >/dev/null 2>&1 || true
    else
        _wcb_warn "docker daemon down — trying 'systemctl start docker'"
        if sudo -n true 2>/dev/null; then sudo -n systemctl start docker >/dev/null 2>&1 || true
        else systemctl start docker >/dev/null 2>&1 || true; fi
    fi
    # Give the daemon up to ~60s to come up.
    local _i
    for _i in $(seq 1 30); do docker info >/dev/null 2>&1 && break; sleep 2; done
    _wcb_check_dockerd || _wcb_err "docker daemon still not reachable — start Docker manually then re-run 'wcb install'."
    return 0
}

# ---- agent image (retag from SHA -> docker load tar -> hf download -> hint) ---
# Locate the `hf` CLI (shipped by huggingface_hub, pinned in requirements.txt).
# Prefer the repo's .venv (guaranteed by Phase 2), then a system-wide `hf`, then
# the legacy `huggingface-cli`. Prints the invocation to stdout, or nothing.
_wcb_locate_hf() {
    local _venv_hf="$_wcb_root/.venv/bin/hf"
    [ -x "$_venv_hf" ] && { printf '%s\n' "$_venv_hf"; return 0; }
    local _venv_hfcli="$_wcb_root/.venv/bin/huggingface-cli"
    [ -x "$_venv_hfcli" ] && { printf '%s download\n' "$_venv_hfcli"; return 0; }
    command -v hf >/dev/null 2>&1 && { printf 'hf\n'; return 0; }
    command -v huggingface-cli >/dev/null 2>&1 && { printf 'huggingface-cli download\n'; return 0; }
    return 1
}
_wcb_check_agent_image() { _wcb_image_present "$_WCB_AGENT_IMAGE"; }
_wcb_fix_agent_image() {
    _wcb_check_dockerd || { _wcb_err "docker daemon not up — cannot provision agent image"; return 1; }
    # (1) retag from a dangling SHA if the layers are already present.
    if docker image inspect "sha256:$_WCB_AGENT_IMAGE_SHA" >/dev/null 2>&1; then
        _wcb_warn "agent image found by SHA — retagging as $_WCB_AGENT_IMAGE"
        docker tag "sha256:$_WCB_AGENT_IMAGE_SHA" "$_WCB_AGENT_IMAGE" >/dev/null 2>&1 || true
    fi
    _wcb_check_agent_image && return 0
    # (2) docker load from the local tar (with pv progress if available).
    if [ -f "$_wcb_root/$_WCB_AGENT_TAR" ]; then
        _wcb_ensure _wcb_check_pv _wcb_fix_pv "pv (progress)" || true
        _wcb_warn "loading agent image from $_WCB_AGENT_TAR (~13 GiB — this takes a while)"
        if command -v pv >/dev/null 2>&1 && _wcb_is_tty; then
            pv "$_wcb_root/$_WCB_AGENT_TAR" | docker load >/dev/null 2>&1 || true
        else
            docker load -i "$_wcb_root/$_WCB_AGENT_TAR" >/dev/null 2>&1 || true
        fi
    fi
    _wcb_check_agent_image && return 0
    # (2b) hf download from the canonical HF dataset, then docker load.
    # Skipped under --offline. Errors (gated repo, missing HF login, disk full,
    # network) fall through to the tier-3 hint, which is now a fallback rather
    # than a first-line handoff.
    if [ "$_WCB_INSTALL_OFFLINE" != "1" ]; then
        local _hf; _hf="$(_wcb_locate_hf)" || _hf=""
        if [ -n "$_hf" ]; then
            _wcb_ensure _wcb_check_pv _wcb_fix_pv "pv (progress)" || true
            _wcb_warn "downloading $_WCB_AGENT_TAR from HF (~13 GiB; needs HF login for gated repos)"
            # Ensure the destination dir exists so hf can materialize into it.
            mkdir -p "$_wcb_root/Images" 2>/dev/null || true
            # hf's own progress bars go to stderr; keep them visible on a TTY,
            # silence them otherwise so batch runs stay clean.
            local _hf_rc=1
            if _wcb_is_tty; then
                ( cd "$_wcb_root" && eval "$_hf internlm/WildClawBench '$_WCB_AGENT_TAR' --repo-type dataset --local-dir ." )
                _hf_rc=$?
            else
                ( cd "$_wcb_root" && eval "$_hf internlm/WildClawBench '$_WCB_AGENT_TAR' --repo-type dataset --local-dir ." >/dev/null 2>&1 )
                _hf_rc=$?
            fi
            if [ "$_hf_rc" -eq 0 ] && [ -f "$_wcb_root/$_WCB_AGENT_TAR" ]; then
                _wcb_warn "loading agent image from freshly-downloaded $_WCB_AGENT_TAR"
                if command -v pv >/dev/null 2>&1 && _wcb_is_tty; then
                    pv "$_wcb_root/$_WCB_AGENT_TAR" | docker load >/dev/null 2>&1 || true
                else
                    docker load -i "$_wcb_root/$_WCB_AGENT_TAR" >/dev/null 2>&1 || true
                fi
            else
                _wcb_warn "hf download did not complete (exit $_hf_rc) — falling back to the manual hint"
            fi
        else
            _wcb_warn "no 'hf' or 'huggingface-cli' on PATH or in .venv — cannot auto-download the agent tar"
        fi
    fi
    _wcb_check_agent_image && return 0
    # (3) last resort: tell the user how to fetch the tar manually.
    _wcb_err "agent image $_WCB_AGENT_IMAGE not present and auto-download did not resolve it."
    _wcb_err "Fetch it manually (may require 'hf auth login' for the gated dataset), then re-run 'wcb install':"
    _wcb_err "  hf download internlm/WildClawBench $_WCB_AGENT_TAR --repo-type dataset --local-dir ."
    return 1
}

# ---- mock image (build via .venv python -> mock_stack) ---------------------
_wcb_check_mock_image() { _wcb_image_present "$_WCB_MOCK_IMAGE"; }
_wcb_fix_mock_image() {
    _wcb_check_dockerd || { _wcb_err "docker daemon not up — cannot build mock image"; return 1; }
    local _py="$_wcb_root/.venv/bin/python3"
    [ -x "$_py" ] || { _wcb_err ".venv python missing — mock build needs the repo venv (run venv phase first)"; return 1; }
    _wcb_warn "building mock image $_WCB_MOCK_IMAGE (~3-5 min)"
    ( cd "$_wcb_root" && "$_py" -c 'from pathlib import Path
from src.utils.mock_stack import build_mock_image_if_needed
import sys
sys.exit(0 if build_mock_image_if_needed(Path("environment")) else 1)' >/dev/null 2>&1 ) || true
    _wcb_check_mock_image || _wcb_err "mock image build failed — inspect: (cd $_wcb_root && .venv/bin/python3 -c 'from src.utils.mock_stack import build_mock_image_if_needed; from pathlib import Path; build_mock_image_if_needed(Path(\"environment\"))')"
    return 0
}

# ---- headroom image (opt-in via --headroom) --------------------------------
_wcb_check_headroom_image() { _wcb_image_present "$_WCB_HEADROOM_IMAGE"; }
_wcb_fix_headroom_image() {
    _wcb_check_dockerd || { _wcb_err "docker daemon not up — cannot build headroom image"; return 1; }
    _wcb_warn "building headroom image $_WCB_HEADROOM_IMAGE"
    ( cd "$_wcb_root" && docker build -f docker/litellm-headroom.Dockerfile -t "$_WCB_HEADROOM_IMAGE" . >/dev/null 2>&1 ) || true
    _wcb_check_headroom_image || _wcb_err "headroom build failed — build manually: docker build -f docker/litellm-headroom.Dockerfile -t $_WCB_HEADROOM_IMAGE ."
    return 0
}

# ---- cc-bridge image -------------------------------------------------------
# Freshness-aware (not presence-only): a stale image with old bridge source is
# treated as missing so `wcb install`/`doctor` rebuild it.
_wcb_check_ccbridge_image() { _wcb_ccbridge_image_fresh; }
_wcb_fix_ccbridge_image() {
    _wcb_check_dockerd || { _wcb_err "docker daemon not up — cannot build cc-bridge image"; return 1; }
    if _wcb_image_present "$_WCB_CCBRIDGE_IMAGE"; then
        _wcb_warn "cc-bridge image out of date vs bridge source — rebuilding"
    else
        _wcb_warn "building cc-bridge image $_WCB_CCBRIDGE_IMAGE (one-time, ~1 min)"
    fi
    _wcb_ccbridge_build || true
    _wcb_check_ccbridge_image || _wcb_err "cc-bridge build failed — build manually: docker build -f docker/cc-bridge/Dockerfile -t $_WCB_CCBRIDGE_IMAGE ."
    return 0
}

# ---- shell-rc wcb() function (+ live-shell definition) ---------------------
_wcb_install_rc() {
    local _os _rc
    _os="$(uname -s)"
    case "${SHELL:-}" in
        */zsh)  _rc="$HOME/.zshrc" ;;
        */bash) _rc="$HOME/.bashrc" ;;
        *)      if [ "$_os" = "Darwin" ]; then _rc="$HOME/.zshrc"; else _rc="$HOME/.bashrc"; fi ;;
    esac
    local _fn="wcb() { source \"$_wcb_root/script/wcb\" \"\$@\"; }"
    if touch "$_rc" 2>/dev/null; then
        grep -vE '^[[:space:]]*wcb\(\)' "$_rc" > "$_rc.tmp" 2>/dev/null || : > "$_rc.tmp"
        printf '%s\n' "$_fn" >> "$_rc.tmp"
        mv "$_rc.tmp" "$_rc" 2>/dev/null && _wcb_ok "installed wcb() in $_rc" || _wcb_warn "could not write $_rc — using live-shell function only"
    else
        _wcb_warn "rc file $_rc not writable — using live-shell function only"
    fi
    # req 5: define wcb() in the LIVE shell right now (works because install is
    # sourced). This is what makes `source script/wcb install; wcb run` work in
    # the SAME terminal with no new shell / no `source ~/.zshrc`.
    eval "$_fn"
}

# ---- THE install orchestrator ----------------------------------------------
_wcb_install() {
    # reset flags + parse args (unknown args ignored, never fatal).
    _WCB_INSTALL_SKIP_IMAGES=0; _WCB_INSTALL_HEADROOM=0; _WCB_INSTALL_FORCE=0; _WCB_INSTALL_OFFLINE=0
    _WCB_PHASE_N=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --skip-images) _WCB_INSTALL_SKIP_IMAGES=1 ;;
            --headroom)    _WCB_INSTALL_HEADROOM=1 ;;
            --force)       _WCB_INSTALL_FORCE=1 ;;
            --offline)     _WCB_INSTALL_OFFLINE=1 ;;
            -h|--help)     _wcb_ok "usage: wcb install [--skip-images] [--headroom] [--force] [--offline]"; return 0 ;;
            *)             _wcb_warn "ignoring unknown install flag: $1" ;;
        esac
        shift
    done
    _wcb_ok "starting one-command install (self-healing) for $_wcb_root"

    local _fail=0

    # Phase 1: host preflight (python / docker / disk / rustc / pv).
    _wcb_phase "host preflight (python, docker, disk, rustc)"
    _wcb_check_disk
    _wcb_ensure _wcb_check_python _wcb_fix_python "python 3.10-3.13" || _fail=1
    _wcb_ensure _wcb_check_pv     _wcb_fix_pv     "pv (progress tool)" || true   # non-fatal
    _wcb_ensure _wcb_check_dockerd _wcb_fix_dockerd "docker daemon" || _fail=1
    _wcb_ensure _wcb_check_rustc  _wcb_fix_rustc  "rustc>=$_WCB_MIN_RUSTC" || \
        _wcb_warn "continuing — a prebuilt litellm wheel may still install without local rustc"

    # Phase 2: .venv + pip (LOUD + fatal on hard failure, with tiered retries).
    _wcb_phase "python venv + requirements"
    _wcb_ensure _wcb_check_venv _wcb_fix_venv ".venv + requirements" || _fail=1
    _wcb_warn_venv_pyver  # non-fatal heads-up if the venv Python is < 3.12

    # Phase 3: .env + secrets.
    _wcb_phase ".env + secrets"
    _wcb_ensure _wcb_check_env _wcb_fix_env ".env OAuth config" || _fail=1

    # Phase 4: OAuth pool (tolerant — only extract if missing/invalid or --force).
    _wcb_phase "OAuth token pool"
    if [ "$_WCB_INSTALL_FORCE" = "1" ]; then
        _wcb_warn "--force: re-extracting OAuth token from OS credential store"
        _wcb_fix_oauth || _fail=1
        _wcb_check_oauth && _wcb_ok "OAuth pool token present + valid" || _fail=1
    else
        _wcb_ensure _wcb_check_oauth _wcb_fix_oauth "OAuth pool token" || _fail=1
    fi

    # Phase 5: git-lfs assets (needed before the agent tar load path).
    _wcb_phase "git-lfs assets"
    _wcb_ensure _wcb_check_lfs _wcb_fix_lfs "git-lfs pointers" || true  # non-fatal

    # Phases 6-8: docker images (skippable).
    if [ "$_WCB_INSTALL_SKIP_IMAGES" = "1" ]; then
        _wcb_phase "agent image (skipped: --skip-images)";   _wcb_warn "skipping agent image"
        _wcb_phase "mock image (skipped: --skip-images)";    _wcb_warn "skipping mock image"
        _wcb_phase "cc-bridge image (skipped: --skip-images)"; _wcb_warn "skipping cc-bridge image"
    else
        _wcb_phase "agent image ($_WCB_AGENT_IMAGE)"
        _wcb_ensure _wcb_check_agent_image _wcb_fix_agent_image "agent image" || _fail=1
        _wcb_phase "mock image ($_WCB_MOCK_IMAGE)"
        _wcb_ensure _wcb_check_mock_image _wcb_fix_mock_image "mock image" || _fail=1
        _wcb_phase "cc-bridge image ($_WCB_CCBRIDGE_IMAGE)"
        _wcb_ensure _wcb_check_ccbridge_image _wcb_fix_ccbridge_image "cc-bridge image" || _fail=1
        if [ "$_WCB_INSTALL_HEADROOM" = "1" ]; then
            _wcb_ensure _wcb_check_headroom_image _wcb_fix_headroom_image "headroom image" || _fail=1
        fi
    fi

    # Phase 9: shell-rc wcb() + live-shell fn, then doctor.
    _wcb_phase "shell function + final doctor"
    _wcb_install_rc

    _wcb_ok "----------------------------------------------------------------"
    if _wcb_doctor; then
        if [ "$_fail" -eq 0 ]; then
            _wcb_ok "install complete — you can run 'wcb run' in THIS terminal now."
        else
            _wcb_warn "install finished but some non-blocking steps failed; doctor is green. 'wcb run' should work."
        fi
        return 0
    else
        _wcb_err "install finished with problems — see the doctor report above and the hints for each failed step."
        return 1
    fi
}

# Read-only health check: verifies every prerequisite on THIS machine and
# reports exactly what is missing, so onboarding issues are self-diagnosable.
_wcb_doctor() {
    local _ok=0
    local _pool="$HOME/.wcb/oauth_pool/account_a.json"
    local _os; _os="$(uname -s)"
    local _dockerd_hint="start Docker Desktop"
    local _dockeri_hint="install Docker Desktop"
    if [ "$_os" != "Darwin" ]; then
        _dockerd_hint="start the docker daemon ('systemctl start docker')"
        _dockeri_hint="install Docker Engine"
    fi
    _wcb_ok "repo: $_wcb_root"
    if [ -f "$_wcb_env" ]; then _wcb_ok ".env present"; else _wcb_err ".env MISSING — run 'wcb setup'"; _ok=1; fi
    if [ -f "$_pool" ]; then
        if _wcb_read_os_creds | _wcb_pool_is_fresh "$_pool"; then
            _wcb_ok "OAuth pool token present + current ($_pool)"
        else
            _wcb_warn "OAuth pool token is stale vs the Claude app login — 'wcb setup' or the next 'wcb run' will refresh it automatically ($_pool)"
        fi
    else
        _wcb_err "OAuth pool token MISSING ($_pool) — run 'wcb setup'"; _ok=1
    fi
    [ -n "$(_wcb_env_get WCB_CC_BRIDGE_SECRET)" ] && _wcb_ok "WCB_CC_BRIDGE_SECRET set" || { _wcb_err "WCB_CC_BRIDGE_SECRET missing — run 'wcb setup'"; _ok=1; }
    if [ -x "$_wcb_root/.venv/bin/python3" ]; then _wcb_ok ".venv present"; else _wcb_err ".venv MISSING — run 'wcb setup'"; _ok=1; fi
    if command -v docker >/dev/null 2>&1; then
        docker info >/dev/null 2>&1 && _wcb_ok "docker daemon up" || { _wcb_err "docker installed but daemon not running — $_dockerd_hint"; _ok=1; }
        if _wcb_ccbridge_image_fresh; then
            _wcb_ok "cc-bridge image present and current"
        elif _wcb_image_present "$_WCB_CCBRIDGE_IMAGE"; then
            _wcb_err "cc-bridge image out of date vs bridge source — run 'wcb install' (or 'wcb setup') to rebuild"; _ok=1
        else
            _wcb_err "cc-bridge image missing — run 'wcb install' (or 'wcb setup')"; _ok=1
        fi
    else
        _wcb_err "docker not found — $_dockeri_hint"; _ok=1
    fi
    _wcb_status_provider
    if [ "$_ok" -eq 0 ]; then _wcb_ok "doctor: all checks passed — ready to 'wcb login' and 'wcb run'"; else _wcb_err "doctor: some checks FAILED (see above)"; fi
    return "$_ok"
}

case "${1:-help}" in
    install) shift; _wcb_install "$@" ;;
    setup)  _wcb_setup ;;
    doctor) _wcb_doctor ;;
    login)  _wcb_login ;;
    logout) _wcb_logout ;;
    status) _wcb_status ;;
    run)    shift; _wcb_run "$@" ;;
    run-legacy) shift; _wcb_run_legacy "$@" ;;
    help|-h|--help)
        cat <<EOF
wcb — WildClawBench launcher + Claude Max OAuth wrapper (reads values from .env)

Run (TUI — the normal path):
  wcb run [task]             open the full-screen config screen, pick backend /
                             model / OAuth account / parallel from dropdowns,
                             press Start. Streaming is always on; interactive
                             mode is auto-detected from the task layout.
  wcb <task-dir>             same — a task path is treated as 'wcb run <task>'
  wcb run                    open the TUI and pick the task there

Subcommands:
  source script/wcb install [flags]       ONE-COMMAND self-healing onboarding.
                                          Sets up venv+deps, .env, OAuth pool,
                                          AND provisions docker images, then
                                          defines wcb() in THIS shell so you can
                                          'wcb run' in the SAME terminal.
                                          flags: --skip-images  --headroom
                                                 --force        --offline
  source script/wcb setup                 ONE-TIME per-laptop onboarding (auto)
  source script/wcb login                 load OAuth vars from .env (subscription ON)
  source script/wcb logout                unset OAuth vars (subscription OFF)
  wcb status                              show login state
  wcb run-legacy <task> [--reps N] [--model M]   old script/run.sh batch path

New machine (one time — ONE terminal):
  source script/wcb install  # self-healing: venv+deps, .env, OAuth pool, docker
                             # images, and defines wcb() in THIS shell. Then just:
  wcb run                    # ...in the SAME terminal (no new shell needed)

Examples:
  wcb run input/input1
  wcb input/input1
  wcb run-legacy input/kayla_morgan_9b8f1d3c-f1f0-40b7-bdbe-f55045abc016 --reps 3
EOF
        ;;
    *)
        # A task path is a run: `wcb input/input1` == `wcb run input/input1`.
        if [ -d "$1" ] || [ -d "$_wcb_root/$1" ]; then
            _wcb_run "$@"
        else
            _wcb_err "unknown subcommand: $1 (try: run | install | setup | login | logout | status | doctor | help)"
        fi
        ;;
esac
