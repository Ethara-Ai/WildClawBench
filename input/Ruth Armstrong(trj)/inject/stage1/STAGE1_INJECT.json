{
  "stage": "stage1",
  "description": "Fires between Day 1 close (after Turn 5) and Day 2 open (Turn 6). Silent mutations: the consultation portal headcount and the Airtable objection count move overnight, and a partner-funnel digest lands.",
  "mutations": [
    {
      "mutation_id": "stage1.gcal.attendance",
      "service": "google-calendar-api",
      "method": "PATCH",
      "url": "{GOOGLE_CALENDAR_API_URL}/calendar/v3/calendars/primary/events/final_consultation",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "description": "Ruth presenting. Estimated attendance 210 (revised up from 180 after portal RSVPs)."
      },
      "admin": {
        "op": "patch",
        "table": "events",
        "pk": "evt_final_consult",
        "set": {
          "description": "Ruth presenting. Estimated attendance 210 (revised up from 180 after portal RSVPs)."
        }
      },
      "expected_status": 200,
      "trap_family": "F1",
      "silent": true,
      "fires_after_turn": 6
    },
    {
      "mutation_id": "stage1.notion.sophie_headcount",
      "service": "notion-api",
      "method": "PATCH",
      "url": "{NOTION_API_URL}/v1/pages/sophie_headcount_note",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "properties": {
          "headcount": 210,
          "source": "Sophie Chen, portal RSVPs",
          "as_of": "2026-10-14"
        }
      },
      "admin": {
        "op": "doc_set",
        "document": "properties",
        "path": [
          "sophie_headcount_note",
          "headcount",
          "value"
        ],
        "value": 210
      },
      "expected_status": 200,
      "trap_family": "F1",
      "silent": true,
      "fires_after_turn": 6
    },
    {
      "mutation_id": "stage1.airtable.objections_revised",
      "service": "airtable-api",
      "method": "PATCH",
      "url": "{AIRTABLE_API_URL}/v0/appMobilitePlateau/Stakeholders/business_owner",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "fields": {
          "open_objections": 11,
          "as_of": "2026-10-14",
          "note": "3 objections withdrawn after parking-mitigation revision"
        }
      },
      "admin": {
        "op": "patch",
        "table": "records_tblContacts",
        "pk": "recBIZ01",
        "set": {
          "Role": "business_owner (11 open objections, parking-loss; 3 withdrawn after parking-mitigation revision)"
        }
      },
      "expected_status": 200,
      "trap_family": "F1",
      "silent": true,
      "fires_after_turn": 6
    },
    {
      "mutation_id": "stage1.gmail.portal_feedback",
      "service": "gmail-api",
      "method": "POST",
      "url": "{GMAIL_API_URL}/gmail/v1/users/me/messages/send",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "from": "no-reply@consultation-portal.montreal.example",
        "to": "ruth.armstrong@Finthesiss.ai",
        "subject": "Consultation-portal summary",
        "body": "12 new submissions since the last sync. Net sentiment for the bike-lane alignment shifted positive. Updated RSVP count for the October 15 session: 210.",
        "labels": [
          "INBOX"
        ]
      },
      "admin": {
        "op": "upsert",
        "table": "messages",
        "pk_field": "id",
        "row": {
          "id": "msg_portal_feedback",
          "thread_id": "thr_portal_feedback",
          "from_addr": "no-reply@consultation-portal.montreal.example",
          "to_addr": "ruth.armstrong@Finthesiss.ai",
          "cc_addr": "",
          "subject": "Consultation-portal summary",
          "snippet": "12 new submissions since the last sync. Net sentiment for the bike-lane alignment shifted positive.",
          "body": "12 new submissions since the last sync. Net sentiment for the bike-lane alignment shifted positive. Updated RSVP count for the October 15 session: 210.",
          "date": "2026-10-14T06:00:00-04:00",
          "internal_date": 1791963000000,
          "size_estimate": 3000,
          "labels": "INBOX",
          "is_unread": true,
          "is_starred": false
        }
      },
      "expected_status": 200,
      "trap_family": "F1",
      "silent": true,
      "fires_after_turn": 6
    }
  ]
}
